# Which LLM backend to use. "mock" needs no API key and runs every pattern
# fully offline with scripted-but-realistic replies -- start here.
LLM_PROVIDER=mock

# --- LLM_PROVIDER=openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Pattern 06 and the capstone: agent-to-agent over HTTP ---
ILLUSTRATION_AGENT_URL=http://localhost:8001
